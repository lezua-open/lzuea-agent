# better-sqlite3 v13 自带 prebuilds/（Node-API），不需要编译。
# 但 npm 从 lockfile 恢复安装时不保留 tarball 里的 gypfile:false 标志，
# 会误触发 node-gyp rebuild（要求本机有 Python + VS Build Tools）。
# 所以跳过所有 install 脚本；Electron 二进制用 npm run setup 单独拉取。
ignore-scripts=true

# Electron 二进制下载走国内镜像（npm run setup 时生效）
electron_mirror=https://npmmirror.com/mirrors/electron/
